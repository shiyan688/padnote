{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padnote.local/schemas/video-explain/render-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "lesson_ir_sha256", "audio_manifest_sha256", "width", "height", "fps", "total_duration_ms", "total_frames", "scenes", "renderer", "ffmpeg"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "lesson_ir_sha256": {"$ref": "#/$defs/sha256"},
    "audio_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "width": {"const": 1080}, "height": {"const": 1920}, "fps": {"const": 30},
    "total_duration_ms": {"type": "integer", "minimum": 1},
    "total_frames": {"type": "integer", "minimum": 1},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scene_id", "audio_path", "start_ms", "end_ms", "start_frame", "end_frame", "keyframe_path"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "audio_path": {"type": "string", "pattern": "^work/audio/"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "keyframe_path": {"type": "string", "pattern": "^work/keyframes/[A-Za-z0-9._/-]+\\.png$"}
        }
      }
    },
    "renderer": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "revideo"}, "version": {"type": "string", "minLength": 1}}
    },
    "ffmpeg": {
      "type": "object", "additionalProperties": false, "required": ["path", "version", "configuration", "license"],
      "properties": {"path": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "configuration": {"type": "string"}, "license": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
