{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padnote.local/schemas/video-explain/lesson-ir.schema.json",
  "title": "PadNote Lesson IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "episode", "claims", "scenes", "render_profile"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_sha256", "note_id", "note_revision"],
      "properties": {
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "note_id": {"type": "string", "minLength": 1},
        "note_revision": {"type": "integer", "minimum": 1}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "audience", "learning_goal", "language", "target_duration_sec"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "audience": {"type": "string", "minLength": 1, "maxLength": 500},
        "learning_goal": {"type": "string", "minLength": 1, "maxLength": 500},
        "language": {"type": "string", "minLength": 2, "maxLength": 32},
        "target_duration_sec": {"type": "integer", "minimum": 1}
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "source_refs", "verification", "confidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "uniqueItems": true},
          "verification": {"enum": ["user-provided", "external-source", "uncertain"]},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 60,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "learning_objective", "claim_ids", "narration", "screen_text", "visual", "estimated_duration_sec"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "learning_objective": {"type": "string", "minLength": 1, "maxLength": 500},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
          "narration": {"type": "string", "minLength": 1, "maxLength": 3000},
          "screen_text": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "visual": {"$ref": "#/$defs/visual"},
          "animation_intent": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "explanation"],
            "properties": {
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "explanation": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          },
          "estimated_duration_sec": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "render_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["aspect_ratio", "width", "height", "fps"],
      "properties": {
        "aspect_ratio": {"const": "9:16"},
        "width": {"const": 1080},
        "height": {"const": 1920},
        "fps": {"const": 30}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 160}}
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "label": {"type": "string", "maxLength": 120}}
    },
    "visual": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "quantity_change"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["unit", "states"],
              "properties": {
                "unit": {"type": "string", "minLength": 1, "maxLength": 12},
                "states": {"type": "array", "minItems": 2, "maxItems": 4, "items": {
                  "type": "object", "additionalProperties": false, "required": ["label", "value"],
                  "properties": {
                    "label": {"type": "string", "minLength": 1, "maxLength": 32},
                    "value": {"type": "number", "exclusiveMinimum": 0}
                  }
                }}
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "title"},
            "data": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 200}, "subtitle": {"type": "string", "maxLength": 300}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "formula_steps"},
            "data": {"type": "object", "additionalProperties": false, "required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "concept_map"},
            "data": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/edge"}}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "process"},
            "data": {"type": "object", "additionalProperties": false, "required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 180}}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "comparison"},
            "data": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/comparisonSide"}, "right": {"$ref": "#/$defs/comparisonSide"}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "data"],
          "properties": {
            "type": {"const": "annotated_source"},
            "data": {"type": "object", "additionalProperties": false, "required": ["asset_path", "annotations"], "properties": {"asset_path": {"type": "string", "pattern": "^input/assets/[A-Za-z0-9._/-]+$"}, "annotations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 240}}}}
          }
        }
      ]
    },
    "comparisonSide": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 100}, "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 180}}}
    }
  }
}
