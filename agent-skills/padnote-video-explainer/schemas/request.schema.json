{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padnote.local/schemas/video-explain/request.schema.json",
  "title": "PadNote video.explain.v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_type", "task_id", "source", "brief", "research", "review", "voice"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_type": {"const": "video.explain.v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_id", "note_revision", "title", "language", "entrypoint", "bundle_sha256"],
      "properties": {
        "note_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "note_revision": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "entrypoint": {"const": "input/content.md"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "learning_goal", "prerequisites", "target_duration_sec", "aspect_ratio", "style_preset"],
      "properties": {
        "audience": {"type": "string", "minLength": 1, "maxLength": 500},
        "learning_goal": {"type": "string", "minLength": 1, "maxLength": 500},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
        "target_duration_sec": {"type": "integer", "minimum": 1},
        "aspect_ratio": {"const": "9:16"},
        "style_preset": {"const": "clean-academic"},
        "user_instructions": {"type": "string", "maxLength": 2000}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_research"],
      "properties": {"external_research": {"type": "boolean"}}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyboard_required"],
      "properties": {"storyboard_required": {"const": true}}
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "speed"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
