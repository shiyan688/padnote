{
  "name": "padnote-video-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "Local worker and Agent Skill for PadNote video.explain.v1 tasks",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {"node": ">=22.22.0"},
  "scripts": {
    "postinstall": "node scripts/apply-revideo-renderer-patch.mjs && node scripts/apply-revideo-ffmpeg-path-patch.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:request": "node --import tsx scripts/validate-request.ts",
    "validate:ir": "node --import tsx scripts/validate-ir.ts",
    "validate:review": "node --import tsx scripts/validate-review.ts",
    "storyboard": "node --import tsx scripts/task-worker.ts storyboard",
    "audio:index": "node --import tsx scripts/index-agent-audio.ts",
    "audio:prepare": "node --import tsx scripts/task-worker.ts audio",
    "audio:fixture": "node --import tsx scripts/generate-fixture-audio.ts",
    "validate:audio": "node --import tsx scripts/validate-audio.ts",
    "validate:render": "node --import tsx scripts/validate-render.ts",
    "render": "DISABLE_TELEMETRY=true node --import tsx scripts/task-worker.ts render",
    "task": "node --import tsx scripts/task-worker.ts",
    "task:approve": "node --import tsx scripts/task-worker.ts approve",
    "task:approve-exact": "node --import tsx scripts/task-worker.ts approve-exact",
    "task:init-exact": "node --import tsx scripts/task-worker.ts init-exact",
    "task:init-operation": "node --import tsx scripts/task-worker.ts initialize-operation",
    "task:storyboard-operation": "node --import tsx scripts/task-worker.ts storyboard-operation",
    "task:approve-operation": "node --import tsx scripts/task-worker.ts approve-operation",
    "task:cancel-operation": "node --import tsx scripts/task-worker.ts cancel-operation",
    "task:revise-operation": "node --import tsx scripts/task-worker.ts revise-operation",
    "task:revision-start-operation": "node --import tsx scripts/task-worker.ts revision-start-operation",
    "task:revision-install-operation": "node --import tsx scripts/task-worker.ts revision-install-operation",
    "task:reconcile-operation": "node --import tsx scripts/task-worker.ts reconcile-operation",
    "task:inspect": "node --import tsx scripts/task-worker.ts inspect",
    "task:builtin": "node --import tsx scripts/builtin-engine.ts",
    "task:review": "node --import tsx scripts/task-worker.ts review",
    "task:status": "node --import tsx scripts/task-worker.ts status",
    "diagnose:runtime": "node --import tsx scripts/diagnose-runtime.ts",
    "task:cancel": "node --import tsx scripts/task-worker.ts cancel",
    "validate:result": "node --import tsx scripts/validate-result.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0",
    "ajv": "8.20.0",
    "katex": "0.18.5",
    "puppeteer": "25.3.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
