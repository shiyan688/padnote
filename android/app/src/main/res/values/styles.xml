<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#355FD2</item>
        <item name="android:navigationBarColor">#F0EEE8</item>
        <item name="android:statusBarColor">#F4F1E8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/PadNoteAlertDialog</item>
        <item name="android:buttonStyle">@style/PadNoteButton</item>
    </style>

    <style name="PadNoteButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/padnote_button_text</item>
        <item name="android:background">@drawable/padnote_button_ripple</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PadNoteAlertDialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/padnote_dialog_button_text</item>
        <item name="android:background">@drawable/padnote_dialog_button_ripple</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="PadNoteAlertDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#355FD2</item>
        <item name="android:textColorPrimary">#1F2933</item>
        <item name="android:textColorSecondary">#6B7684</item>
        <item name="android:windowBackground">@drawable/padnote_dialog_background</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PadNoteAlertDialogAction</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PadNoteAlertDialogAction</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PadNoteAlertDialogAction</item>
    </style>

    <style name="PadNoteSelectionDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/padnote_dialog_button_text</item>
        <item name="android:background">@drawable/padnote_dialog_button_ripple</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="PadNoteSelectionDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#355FD2</item>
        <item name="android:textColorPrimary">#1F2933</item>
        <item name="android:textColorSecondary">#6B7684</item>
        <item name="android:windowBackground">@drawable/padnote_selection_dialog_background</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PadNoteSelectionDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PadNoteSelectionDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PadNoteSelectionDialogButton</item>
        <item name="android:windowMinWidthMajor">82%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
