<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33285EA8">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><corners android:radius="19dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke android:width="1dp" android:color="#ECE9E2" />
                    <corners android:radius="19dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/padnote_selection_chevron" android:gravity="right|center_vertical" android:right="10dp" />
        </layer-list>
    </item>
</ripple>
