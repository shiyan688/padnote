{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PadNote demo render specification",
  "type": "object",
  "required": [
    "title",
    "tagline",
    "closing_text",
    "output",
    "width",
    "height",
    "fps",
    "title_seconds",
    "closing_seconds",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "pattern": "^output/.+\\.mp4$"
    },
    "width": {
      "type": "integer",
      "minimum": 640,
      "multipleOf": 2
    },
    "height": {
      "type": "integer",
      "minimum": 360,
      "multipleOf": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60
    },
    "title_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 8
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clip",
          "in",
          "out",
          "caption",
          "label"
        ],
        "properties": {
          "clip": {
            "type": "string",
            "pattern": "^recordings/raw/"
          },
          "in": {
            "type": "number",
            "minimum": 0
          },
          "out": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 30
          }
        },
        "additionalProperties": false
      }
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "closing_text": {
      "type": "string",
      "minLength": 1
    },
    "closing_seconds": {
      "type": "number",
      "minimum": 2,
      "maximum": 8
    }
  },
  "additionalProperties": false
}
